{
  "name": "studyup",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run --exclude 'e2e/**'",
    "infra:verify": "node scripts/verify-infra.mjs",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --grep @public",
    "test:e2e:live": "playwright test --grep @live",
    "test:e2e:local": "node --env-file=.env.e2e.local ./node_modules/@playwright/test/cli.js test --grep 'creates and deletes a course' --project=chromium",
    "test:e2e:local:full": "node --env-file=.env.e2e.local ./node_modules/@playwright/test/cli.js test --grep @live --project=chromium",
    "check": "npm run lint && npm run typecheck && npm run test && npm run infra:verify && npm run build",
    "preview": "vite preview",
    "supabase:start": "supabase start",
    "supabase:start:test": "supabase start -x gotrue,realtime,storage-api,imgproxy,kong,mailpit,postgrest,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:functions": "supabase functions serve --env-file supabase/.env.local",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local --level warning --fail-on warning",
    "db:types": "supabase gen types --local --lang typescript",
    "env:local": "node scripts/setup-local-env.mjs",
    "e2e:user:local": "node scripts/setup-local-e2e-user.mjs",
    "dev:local": "concurrently -k -n functions,web -c magenta,cyan \"npm run supabase:functions\" \"npm run dev\"",
    "vercel:link": "npx --yes vercel@58.4.0 link",
    "vercel:pull": "npx --yes vercel@58.4.0 pull --yes",
    "vercel:build": "npx --yes vercel@58.4.0 build",
    "deploy:preview": "npx --yes vercel@58.4.0 deploy",
    "deploy:production": "npx --yes vercel@58.4.0 deploy --prod",
    "supabase:deploy:check": "supabase db push --dry-run",
    "supabase:deploy": "supabase db push && supabase functions deploy chat-with-gemini && supabase functions deploy generate-study-plan"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.3.0",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "^5.3.31",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.3",
    "recharts": "^2.12.7",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.3",
    "wouter": "^3.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "postcss": "^8.5.25",
    "supabase": "^2.110.0",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
